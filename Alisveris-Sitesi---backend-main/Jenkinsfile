pipeline {
    agent any

    options {
        // Git whatchanged hatasını kesin olarak engeller
        skipDefaultCheckout(true)
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo '📦 Proje build ediliyor...'
                sh 'mvn clean compile'
            }
        }

        stage('Unit Tests') {
            steps {
                echo '🧪 Unit testler çalıştırılıyor...'
                sh 'mvn test'
            }
        }

        stage('Integration Tests') {
            steps {
                echo '🔗 Integration testler çalıştırılıyor...'
                sh 'mvn verify -DskipUnitTests=true'
            }
        }

        stage('Run Application') {
            steps {
                echo '🚀 Uygulama ayağa kaldırılıyor (8084)...'
                sh '''
                mvn spring-boot:run &
                '''
                // Uygulamanın ayağa kalkması için bekle
                sleep time: 20, unit: 'SECONDS'
            }
        }

        stage('Selenium Tests') {
            steps {
                echo '🤖 Selenium testleri çalıştırılıyor...'
                sh 'mvn test -Dtest=Selenium*'
            }
        }
    }

    post {
        always {
            echo '📊 Test raporları arşivleniyor...'
            junit '**/target/surefire-reports/*.xml'
        }

        success {
            echo '✅ Pipeline başarıyla tamamlandı!'
        }

        failure {
            echo '❌ Pipeline hata aldı!'
        }
    }
}
